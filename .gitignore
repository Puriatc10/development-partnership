# Environment & Secrets
.env
.env.*
!.env.example
*.local
*.pem
*.key

# Python caches
__pycache__/
*.py[cod]
*$py.class

# Local virtualenv (recreate with: uv venv .venv && uv pip install -r requirements.txt)
.venv/
venv/

# Local logical backups of the Development CRM (never commit business data)
backups/

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Logs & Diagnostics
*.log
npm-debug.log*
yarn-debug.log*

# Node / Dependency caches (if any used in future)
node_modules/
dist/
build/
